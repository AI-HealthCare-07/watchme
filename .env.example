# cp .env.example .env 후 값 채우기
POSTGRES_PASSWORD=change-me
# 링크·QR에 쓰이는 공개 주소 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:8000
# Caddy가 80/443을 받을 서버 LAN IP (공유기 DHCP 고정 할당과 같게)
LAN_IP=127.0.0.1
# DDNS (ddns/update.py): porkbun.com/account/api 에서 발급, 도메인 API Access 켜기
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
