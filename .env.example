# cp .env.example .env 후 값 채우기
POSTGRES_PASSWORD=change-me
# 링크·QR에 쓰이는 공개 주소 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:8000
# Caddy가 80/443을 받을 서버 LAN IP (공유기 DHCP 고정 할당과 같게)
LAN_IP=127.0.0.1
# DDNS (ddns/update.py): porkbun.com/account/api 에서 발급, 도메인 API Access 켜기
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# 카카오 연동: developers.kakao.com 앱의 REST API 키와 클라이언트 시크릿 (사용자가 직접 입력)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 토큰 암호화 키 (Fernet). 생성 명령은 docs/server-runbook.md 12장. 잃어버리면 사용자가 카톡을 다시 연결해야 함
TOKEN_KEY=
# AI 한 줄 요청: aistudio.google.com 에서 이 앱용 키를 따로 발급 (사용자가 직접 입력). 비우면 AI 기능 꺼짐
GEMINI_API_KEY=
# 비우면 app/ai.py의 DEFAULT_MODEL
GEMINI_MODEL=
